# Copy to .env and adjust if needed.
# SQLite database URL (used by Prisma CLI + app on main branch).
# The file is created at prisma/dev.db on first migrate/seed.
DATABASE_URL="file:./dev.db"

# MongoDB branch (mongodb-migration): MongoDB Atlas free M0.
# Get URI from Atlas -> Connect -> Drivers -> Node.js, replace <password>.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="abc-university"
